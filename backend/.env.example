# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O arquivo .env NÃO deve ser commitado no Git (já está no .gitignore).

# Porta em que o servidor vai rodar (site + painel + API, em localhost;
# no Render essa variável é definida automaticamente por eles).
PORT=3000

# Connection string do Postgres (Supabase). Em Project Settings > Database
# no painel do Supabase, copie a "Connection string" no modo "Transaction
# pooler" (porta 6543) — funciona melhor com hosts como o Render do que a
# conexão direta. Troque [SUA-SENHA] pela senha do banco definida na
# criação do projeto Supabase.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Origem(ns) autorizadas a chamar a API, separadas por vírgula. Necessário
# porque em produção o site (GitHub Pages) e o backend (Render) ficam em
# domínios diferentes. Inclua a URL exata do site publicado, sem barra no
# final.
CORS_ORIGIN=https://synct-labs.github.io

# Credenciais do administrador inicial. Usadas apenas na primeira
# execução, para criar a conta de administrador no banco. Depois disso
# pode (e deve) trocar a senha pelo próprio painel.
ADMIN_EMAIL=admin@marquesenergiasolar.com.br
ADMIN_PASSWORD=troque-esta-senha-antes-de-usar

# Por quantas horas a sessão do admin fica válida após o login.
SESSION_TTL_HOURS=168

# "production" ativa o cookie Secure + SameSite=None (necessário para o
# cookie de login funcionar entre domínios diferentes). No Render, defina
# NODE_ENV=production nas variáveis de ambiente do serviço. Deixe
# "development" só quando estiver rodando tudo junto em localhost.
NODE_ENV=development

# E-mail para verificação em duas etapas por e-mail (ver "Configurar envio
# de e-mail" no README). Sem essa chave, o código de verificação só aparece
# no log do servidor (modo de teste) — ninguém recebe e-mail de verdade.
# 1. Crie uma conta grátis em https://resend.com
# 2. Em API Keys, crie uma chave e cole abaixo.
RESEND_API_KEY=
# Remetente que aparece pro cliente. O domínio de teste do Resend
# (onboarding@resend.dev) funciona sem configurar nada, mas só envia pro
# e-mail com que você criou a conta Resend — pra enviar pra qualquer
# cliente de verdade, verifique um domínio próprio em Resend > Domains e
# troque para algo como "Marques <verificacao@seudominio.com.br>".
MAIL_FROM=Marques <onboarding@resend.dev>
